{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openxcraft.github.io/idea/schema/idea_frontmatter.schema.json",
  "title": "Swarm idea frontmatter (extended schema)",
  "description": "Strict schema for every idea file in ideas/. Base fields come from the original swarm spec; the extended fields implement the Cross-Domain Diversity Generator addendum. Enforced by scripts/swarm_index.py between validation and hashing. All enum values MUST exist in tags/diversity_matrices.yaml.",
  "type": "object",
  "required": [
    "id", "title", "slug", "summary", "status", "created_at", "run_id", "tags",
    "platform", "software_class", "solution_category", "architecture", "scale",
    "language", "stack", "layer", "threat_model", "from_scratch", "novelty_axis"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Stable slug-like id, unique across the corpus." },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "summary": { "type": "string", "minLength": 60, "description": "One-paragraph plain-text summary of what is built de novo." },
    "status": { "type": "string", "enum": ["accepted", "draft", "rejected"] },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": { "type": "string" },
      "description": "Topic tags from tags/taxonomy.yaml domains."
    },

    "platform": { "type": "string", "enum": ["desktop", "mobile", "web", "cli", "tui", "browser_extension", "ide_extension", "editor_plugin", "server_backend", "cloud_service", "serverless_function", "edge_runtime", "embedded_mcu", "iot", "wearables", "smart_tv", "automotive", "robotics", "ar_vr_xr", "game_console", "kernel_driver", "bootloader", "firmware", "protocol_daemon", "container_image", "wasm_module"] },
    "software_class": { "type": "string", "enum": ["end_user_app", "library", "framework", "sdk", "api", "microservice", "monolith", "plugin", "protocol_spec", "compiler", "interpreter", "transpiler", "linter", "formatter", "package_manager", "database", "storage_engine", "cache", "queue", "scheduler", "orchestrator", "runtime", "emulator", "simulator", "game", "tool", "dev_tool", "test_harness", "fuzzer", "profiler", "debugger", "observability_agent", "ml_model", "ml_pipeline", "autonomous_agent", "scraper", "crawler", "dapp", "smart_contract", "p2p_node", "mesh_node", "cryptographic_primitive", "consensus_module", "identity_system", "payment_rail", "filesystem", "network_stack", "build_system", "ci_cd_component"] },
    "solution_category": { "type": "string", "enum": ["automation", "productivity", "communication", "collaboration", "security", "privacy", "anonymity", "censorship_resistance", "data_engineering", "data_leak_prevention", "ai_egress_control", "content_moderation", "media_processing", "generative_tooling", "education", "research_tooling", "scientific_computing", "health", "accessibility", "finance", "commerce", "logistics", "governance", "legal_tech", "infrastructure", "observability", "resilience_backup", "offline_first", "low_resource_edge_compute", "sustainability", "creative_tools", "gaming", "simulation"] },
    "architecture": { "type": "string", "enum": ["single_user_local", "single_tenant_server", "multi_tenant_saas", "self_hosted", "federated", "decentralized", "p2p", "offline_first", "sync_based", "event_driven", "stream_processing", "batch", "real_time", "embedded_in_another_app", "library_only", "protocol_first", "hardware_paired"] },
    "scale": { "type": "string", "enum": ["solo_dev", "small_team", "org_wide", "internet_scale"] },
    "language": { "type": "string", "enum": ["c", "cpp", "rust", "zig", "go", "java", "kotlin", "scala", "csharp", "fsharp", "python", "ruby", "php", "lua", "javascript", "typescript", "node", "deno", "bun", "haskell", "ocaml", "elixir", "clojure", "swift", "kotlin_android", "dart", "sql", "r_lang", "julia", "fortran", "matlab", "solidity", "move", "bash", "posix_shell", "other"] },
    "stack": { "type": "string", "enum": ["systems", "jvm", "dotnet", "scripting", "js_ts", "functional", "mobile_native", "data", "scientific", "blockchain", "shell", "other"] },
    "layer": { "type": "string", "enum": ["application", "service", "library", "framework", "protocol", "runtime", "kernel_driver", "firmware", "spec_standard", "research_prototype"] },

    "threat_model": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["passive_network_observer", "active_mitm", "malicious_server", "malicious_client", "compromised_endpoint", "supply_chain_attacker", "side_channel_observer", "physical_access_attacker", "insider", "coerced_disclosure", "mass_surveillance", "targeted_surveillance"] },
      "description": "Mandatory. Ideas claiming privacy/anonymity/security/censorship-resistance without naming at least one threat model are rejected (rule c)."
    },

    "from_scratch": { "type": "boolean", "description": "Must be true unless dependency_declared is non-empty (rule b)." },
    "dependency_declared": {
      "type": "array",
      "maxItems": 1,
      "items": { "type": "string" },
      "description": "At most ONE primary dependency, and it must be a general-purpose runtime/language/toolchain — never the idea's substance."
    },
    "novelty_axis": { "type": "string", "enum": ["platform", "class", "category", "architecture", "threat_model", "combination"], "description": "Which diversity axis this idea contributes novelty on." },

    "body_sections": {
      "type": "array",
      "description": "Informational only — enforced by the linter in scripts/swarm_index.py, not the schema.",
      "items": { "type": "string", "enum": ["problem", "de_novo_scope", "architecture_and_components", "stack_rationale", "threat_model_analysis", "novelty_statement", "acceptance_criteria"] }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "from_scratch": { "const": false } },
        "required": ["from_scratch"]
      },
      "then": {
        "properties": { "dependency_declared": { "minItems": 1 } },
        "required": ["dependency_declared"]
      }
    }
  ]
}
